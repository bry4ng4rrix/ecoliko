# Variables lues par docker-compose.yml lui-même (substitution ${...}), à ne pas confondre
# avec backend/.env (variables d'exécution du conteneur Django — voir backend/.env.example).
# Copier vers `.env` à la racine avant `docker compose up`.

# URL absolue du backend telle que le NAVIGATEUR doit la joindre (Vite l'inline au build,
# donc changer cette valeur nécessite un rebuild : docker compose build frontend).
VITE_API_URL=https://api.mon-ecole.mg/api
