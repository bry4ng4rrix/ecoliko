# Copier vers `.env` (ou définir ces variables dans docker-compose.yml / le panneau du VPS)
# et remplir les vraies valeurs avant de déployer. Aucune de ces variables n'est requise en
# local : sans `.env`, le backend garde son comportement de développement actuel.

# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

DEBUG=False

# Domaine(s)/IP du VPS, séparés par des virgules (ex: api.mon-ecole.mg,123.45.67.89)
ALLOWED_HOSTS=

# Origine(s) exacte(s) autorisée(s) pour le frontend (ex: https://mon-ecole.mg) — laisser vide
# pour retomber sur CORS_ALLOW_ALL_ORIGINS=True (déconseillé en production).
CORS_ALLOWED_ORIGINS=

# Chemin SQLite à l'intérieur du conteneur — pointe vers le volume monté par
# docker-compose.yml (/app/data) pour que les données survivent aux redéploiements.
# Pour Postgres : DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:////app/data/db.sqlite3

# Défini automatiquement par docker-compose.yml (pointe vers le service `redis` du réseau
# interne) — inutile de le renseigner ici sauf déploiement sans docker-compose (Redis externe).
REDIS_URL=
